# ---- server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/taskflow

# ---- database ----
# Either set DATABASE_URL, or the individual PG* values below.
# DATABASE_URL=postgres://user:password@localhost:5432/ekosight
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=taskflow
PGSSL=false
# every TaskFlow table lives in this schema, so it can share the existing database safely
DB_SCHEMA=taskflow

# ---- auth ----
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_TTL=12h
# set true when mounting inside the existing app and reusing its session
TRUST_HOST_AUTH=false

# ---- misc ----
CORS_ORIGINS=http://localhost:5173
ENABLE_SCANNER=true
SCANNER_INTERVAL_MINUTES=15
AUTO_MIGRATE=true

# ---- seed ----
ADMIN_EMAIL=admin@ekosight.com
ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO=false

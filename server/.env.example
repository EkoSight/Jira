# ---- server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/taskflow

# ---- database ----
# Either set DATABASE_URL, or the individual PG* values below.
# DATABASE_URL=postgres://user:password@localhost:5432/ekosight
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=taskflow
PGSSL=false
# every TaskFlow table lives in this schema, so it can share the existing database safely
DB_SCHEMA=taskflow

# ---- auth ----
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_TTL=12h
# set true when mounting inside the existing app and reusing its session
TRUST_HOST_AUTH=false

# ---- attachments ----
# Images and documents attached to tasks are stored here, NOT in the database.
# On a server this must point OUTSIDE the deployment folder, e.g.
#   UPLOAD_DIR=/var/lib/taskflow/uploads
# otherwise a redeploy can delete them. Back it up with the database.
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# ---- misc ----
CORS_ORIGINS=http://localhost:5173
ENABLE_SCANNER=true
SCANNER_INTERVAL_MINUTES=15
AUTO_MIGRATE=true

# ---- seed ----
ADMIN_EMAIL=admin@ekosight.com
ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO=false

# ---- email marketing (docs/EMAIL_MARKETING.md) ----
# ses | brevo | smtp. Unset: outbox only in development, sending off in production.
EMAIL_PROVIDER=
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
AWS_SES_SNS_TOPIC_ARN=
BREVO_API_KEY=
EMAIL_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MARKETING_INBOUND_KEY=
MARKETING_CONVERSION_KEY=
ANTHROPIC_API_KEY=
MARKETING_WORKER=true
MARKETING_WORKER_INTERVAL_SECONDS=15

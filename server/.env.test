# Loaded by `npm test` via node --env-file. Keeps the suite in its own schema so
# it can never touch working data.
NODE_ENV=test
DB_SCHEMA=taskflow_test
JWT_SECRET=test-only-secret
ENABLE_SCANNER=false
AUTO_MIGRATE=false
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=taskflow
